generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  vehicles     Vehicle[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Vehicle {
  id             String   @id @default(cuid())
  year           Int
  make           String
  model          String
  trim           String?
  vin            String?  @unique
  licensePlate   String?
  currentMileage Int
  expectedMpg    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  fuelRecords        FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
}

model MaintenanceRecord {
  id                 String   @id @default(cuid())
  serviceType        String
  serviceDate        DateTime
  mileage            Int
  cost               Float?
  shop               String?
  notes              String?
  nextServiceDate    DateTime?
  nextServiceMileage Int?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FuelRecord {
  id             String   @id @default(cuid())
  date           DateTime
  mileage        Int
  gallons        Float
  pricePerGallon Float?
  totalCost      Float?
  station        String?
  notes          String?

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

